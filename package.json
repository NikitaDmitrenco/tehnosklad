{
  "name": "tehnosklad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:smoke": "playwright test e2e/admin-smoke.spec.ts",
    "test:integration:local": "node scripts/test-integration-local.mjs --local-only",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset:local": "supabase db reset --local",
    "db:lint:local": "supabase db lint --local --schema public --level warning --fail-on error",
    "db:types:local": "supabase gen types --local --schema public",
    "upload:category-images": "node scripts/upload-category-images.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
