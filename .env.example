# Browser-safe. These values are embedded in the frontend bundle.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production. Production accepts only `supabase`.
# Development/test default to demo when this variable is absent.
CATALOG_DATA_SOURCE=supabase

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only lead abuse protection. Use at least 32 random characters.
LEAD_IP_HASH_SECRET=

# Optional for local development, required for production Telegram delivery.
# A missing/invalid configuration never rolls back a saved lead; it is logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server-only grounded catalog assistant. `fallback` needs no external API.
# Supported provider values: fallback, openai-compatible, anthropic.
AI_PROVIDER=fallback
# Required for `openai-compatible` (Bearer token) and `anthropic` (x-api-key).
AI_PROVIDER_API_KEY=
# Required for both paid providers, e.g. claude-opus-5 for `anthropic`.
AI_MODEL=
# Required for `openai-compatible`: HTTPS endpoint ending in /v1.
# Optional for `anthropic`: gateway host without the /v1 path
# (default: https://api.anthropic.com). Provider calls are server-side, so no
# browser CSP entry is needed for either provider.
AI_PROVIDER_BASE_URL=
# Use a dedicated random value of at least 32 characters; never reuse lead secrets.
AI_RATE_LIMIT_SECRET=
# Optional bounded upstream request timeout in milliseconds (default: 8000).
AI_TIMEOUT_MS=

# Server-rendered legal operator details. These are not secrets, but all four
# required values must be set before enabling public lead forms in production.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_IDNO=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PRIVACY_EMAIL=
# Optional: publish only when an appointed contact exists.
LEGAL_RESPONSIBLE_PERSON=
